# Skopiuj do `.env` (nie commituj `.env`).
# Docker Compose: zmienne z ? muszą być ustawione.

# --- Google Gemini (wymagane) ---
GEMINI_API_KEY=

# --- Baza (wymagane w compose) ---
# Przykład lokalny:
# DATABASE_URL=postgresql+psycopg2://admin:admin@host.docker.internal:9191/postgres
DATABASE_URL=

# --- HTTP ---
PORT=8000

# --- CORS — adresy frontu (Next), po przecinku; pełny origin z https:// dla Vercela ---
# Końcowy / w URL jest normalizowany przy starcie backendu.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://frontend-hack26.vercel.app

# --- Modele ---
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
RAG_TOP_K=6

# --- Dev: tworzenie tabel przy starcie ---
SQLALCHEMY_CREATE_ALL=false

# --- Railway / S3-compatible bucket (logo firm) — opcjonalnie ---
ENDPOINT=
BUCKET=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
REGION=auto
BUCKET_PRESIGN_EXPIRES=604800

# --- Frontend (Next.js; musi zawierać schemat: https://... dla Railway) ---
# NEXT_PUBLIC_API_URL=https://twoj-backend.up.railway.app
